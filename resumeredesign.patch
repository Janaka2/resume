+/* =====================================================================
+   Janaka Premathilaka — shared design system
+   Extracted from partials/janaka_visual_resume_v3_3.html (source of truth)
+   Plain CSS, no frameworks, no build step.
+   ===================================================================== */
+
+/* ============ tokens ============ */
+:root{
+  --bg:#FAFBFD; --bg2:#FFFFFF; --tx:#10243E; --tx2:#5B6B7F;
+  --ln:#DCE3EB; --ac:#0E7C66; --ok:#18A36C; --chip:#F1F5F9;
+  --shadow:0 1px 2px rgba(16,36,62,.05),0 8px 24px rgba(16,36,62,.06);
+  --r:12px;
+  --font-sans:"IBM Plex Sans",system-ui,sans-serif;
+  --font-mono:"IBM Plex Mono",monospace;
+  --font-head:"Archivo",sans-serif;
+}
+html[data-theme="dark"]{
+  --bg:#0B1626; --bg2:#101E33; --tx:#E6EDF6; --tx2:#93A4BA;
+  --ln:#233650; --ac:#2EB596; --ok:#2ECB87; --chip:#16263D;
+  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px rgba(0,0,0,.35);
+}
+
+/* ============ base ============ */
+*{box-sizing:border-box;margin:0;padding:0}
+html{scroll-behavior:smooth}
+body{
+  background:var(--bg);color:var(--tx);
+  font:400 1rem/1.65 var(--font-sans);
+  -webkit-font-smoothing:antialiased;
+  transition:background .25s ease,color .25s ease;
+}
+section{scroll-margin-top:84px}
+.wrap{max-width:1020px;margin:0 auto;padding:0 24px}
+a{color:var(--ac)}
+img{max-width:100%}
+:focus-visible{outline:2px solid var(--ac);outline-offset:2px;border-radius:4px}
+.mono{font-family:var(--font-mono)}
+.eyebrow{
+  font-family:var(--font-mono);font-size:.72rem;font-weight:500;
+  letter-spacing:.18em;text-transform:uppercase;color:var(--ac);margin-bottom:10px;
+}
+h2{font-family:var(--font-head);font-weight:700;font-size:clamp(1.45rem,3vw,1.9rem);letter-spacing:-.01em;margin-bottom:18px}
+.sec{padding:72px 0 0}
+.lede{color:var(--tx2);max-width:62ch}
+
+/* ============ top bar ============ */
+.topbar{
+  position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 82%,transparent);
+  backdrop-filter:blur(10px);border-bottom:1px solid var(--ln);
+}
+.topbar .wrap{display:flex;align-items:center;gap:18px;height:56px}
+.logo{font-family:var(--font-head);font-weight:800;font-size:1.05rem;color:var(--tx);text-decoration:none;letter-spacing:-.02em}
+.logo b{color:var(--ac)}
+.topbar nav{margin-left:auto;display:flex;gap:14px;align-items:center}
+.topbar nav a{
+  font-family:var(--font-mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;
+  color:var(--tx2);text-decoration:none;
+}
+.topbar nav a:hover{color:var(--ac)}
+.iconbtn{
+  border:1px solid var(--ln);background:var(--bg2);color:var(--tx);border-radius:8px;
+  height:34px;cursor:pointer;line-height:1;
+}
+.iconbtn:hover{border-color:var(--ac)}
+#themeBtn{width:34px;font-size:.95rem}
+#langBtn{padding:0 10px;font-family:var(--font-mono);font-size:.72rem;letter-spacing:.08em;font-weight:500}
+@media(max-width:760px){.topbar nav a.navlink{display:none}}
+
+/* ============ hero ============ */
+.hero{padding:64px 0 0}
+.hero-grid{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:start}
+.status{
+  font-family:var(--font-mono);font-size:.78rem;color:var(--tx2);
+  display:flex;align-items:center;gap:8px;margin-bottom:18px;min-height:1.3em;
+}
+.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);flex:0 0 auto;animation:pulse 2.4s infinite}
+@keyframes pulse{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--ok) 45%,transparent)}55%{box-shadow:0 0 0 7px transparent}}
+h1{font-family:var(--font-head);font-weight:800;font-size:clamp(2.3rem,6vw,3.9rem);line-height:1.02;letter-spacing:-.025em}
+.role{font-family:var(--font-head);font-weight:600;font-size:clamp(1.05rem,2.4vw,1.35rem);color:var(--ac);margin:12px 0 4px}
+.hook{font-size:clamp(1rem,2vw,1.12rem);color:var(--tx2);max-width:54ch;margin-top:10px}
+.hook b{color:var(--tx);font-weight:600}
+.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
+.badge{
+  font-family:var(--font-mono);font-size:.72rem;color:var(--tx2);
+  border:1px solid var(--ln);border-radius:999px;padding:5px 11px;background:var(--bg2);
+}
+.badge.hot{color:var(--ac);border-color:color-mix(in srgb,var(--ac) 40%,var(--ln))}
+.photo-card{text-align:center}
+.photo-card img{
+  width:172px;height:auto;border-radius:14px;display:block;
+  border:1px solid var(--ln);box-shadow:var(--shadow);
+}
+.photo-card figcaption{font-family:var(--font-mono);font-size:.7rem;color:var(--tx2);margin-top:10px;letter-spacing:.08em}
+@media(max-width:680px){
+  .hero-grid{grid-template-columns:1fr}
+  .photo-card{order:-1;text-align:left}
+  .photo-card img{width:128px;margin:0}
+}
+
+/* ============ buttons ============ */
+.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
+.btn{
+  display:inline-flex;align-items:center;gap:8px;text-decoration:none;cursor:pointer;
+  font:500 .86rem/1 var(--font-sans);border-radius:10px;padding:11px 16px;
+  border:1px solid var(--ln);background:var(--bg2);color:var(--tx);
+  transition:transform .12s ease,border-color .12s ease,background .12s ease;
+}
+.btn:hover{transform:translateY(-1px);border-color:var(--ac)}
+.btn.primary{background:var(--ac);border-color:var(--ac);color:#fff}
+html[data-theme="dark"] .btn.primary{color:#06121F}
+.btn.primary:hover{filter:brightness(1.06)}
+.linkbtn{
+  background:none;border:none;cursor:pointer;color:var(--ac);
+  font-family:var(--font-mono);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;padding:0;
+}
+.linkbtn:hover{text-decoration:underline}
+
+/* ============ stats band ============ */
+.stats{
+  display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:44px;
+  border-top:1px solid var(--ln);border-bottom:1px solid var(--ln);
+}
+.stat{padding:20px 18px 22px;border-left:1px solid var(--ln)}
+.stat:first-child{border-left:none;padding-left:0}
+.stat b{font-family:var(--font-head);font-weight:800;font-size:clamp(1.5rem,3.4vw,2.1rem);letter-spacing:-.02em;display:block}
+.stat span{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.06em;color:var(--tx2);display:block;margin-top:4px}
+@media(max-width:680px){
+  .stats{grid-template-columns:1fr 1fr}
+  .stat{padding-left:0;border-left:none;border-top:1px solid var(--ln)}
+  .stat:nth-child(-n+2){border-top:none}
+}
+
+/* ============ cards ============ */
+.card{border:1px solid var(--ln);border-radius:var(--r);background:var(--bg2);padding:20px;box-shadow:var(--shadow)}
+.card:hover{border-color:color-mix(in srgb,var(--ac) 35%,var(--ln))}
+.card h3{font-family:var(--font-head);font-weight:700;font-size:1.02rem;margin-bottom:4px}
+.card .sub{font-family:var(--font-mono);font-size:.76rem;color:var(--tx2)}
+.card ul{list-style:none;margin-top:12px;display:grid;gap:8px}
+.card li{padding-left:18px;position:relative;font-size:.95rem;color:color-mix(in srgb,var(--tx) 88%,var(--tx2))}
+.card li::before{content:"—";position:absolute;left:0;color:var(--ac)}
+.card li small{font-family:var(--font-mono);font-size:.7rem;color:var(--tx2);display:block}
+.zlabel{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ac);margin-bottom:12px}
+.cards2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:8px}
+.cards3{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px;margin-top:8px}
+@media(max-width:680px){.cards2{grid-template-columns:1fr}}
+
+/* ============ chips ============ */
+.chips{display:flex;flex-wrap:wrap;gap:7px}
+.chip{
+  font-family:var(--font-mono);font-size:.74rem;color:var(--tx);
+  background:var(--chip);border:1px solid var(--ln);border-radius:7px;padding:5px 9px;
+}
+
+/* ============ contact list (profile card) ============ */
+.clist{list-style:none;display:grid;gap:10px}
+.clist li{display:flex;gap:10px;align-items:baseline;font-size:.95rem}
+.clist .k{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--tx2);min-width:74px}
+.clist a{color:var(--tx);text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--ac) 45%,transparent)}
+.clist a:hover{color:var(--ac)}
+
+/* ============ language meter ============ */
+.langs{display:grid;gap:0;border-top:1px solid var(--ln);margin-top:4px}
+.lang{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid var(--ln)}
+.lang .nm{font-weight:600;font-size:.95rem}
+.lang .lvl{font-family:var(--font-mono);font-size:.72rem;color:var(--tx2);grid-column:1}
+.lang .lvl b{color:var(--ac);font-weight:500}
+.lang .meter{grid-row:span 2;display:flex;gap:4px}
+.seg{width:18px;height:7px;border-radius:3px;background:var(--chip);border:1px solid var(--ln)}
+.seg.f{background:var(--ac);border-color:var(--ac)}
+
+/* ============ timeline ============ */
+.tl{list-style:none;margin-top:8px;position:relative;padding-left:26px}
+.tl::before{content:"";position:absolute;left:5px;top:8px;bottom:8px;width:2px;background:var(--ln)}
+.tl>li{position:relative;padding:0 0 38px}
+.tl>li::before{
+  content:"";position:absolute;left:-26px;top:7px;width:12px;height:12px;border-radius:50%;
+  background:var(--bg);border:2.5px solid var(--tx2);
+}
+.tl>li.live::before{border-color:var(--ok);background:var(--ok);animation:pulse 2.4s infinite}
+.tl .when{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.06em;color:var(--tx2)}
+.tl .when b{color:var(--ac);font-weight:500}
+.tl h3{font-family:var(--font-head);font-weight:700;font-size:1.12rem;margin:6px 0 2px;letter-spacing:-.01em}
+.tl .org{font-family:var(--font-mono);font-size:.8rem;color:var(--tx2);margin-bottom:10px}
+.tl ul.points{list-style:none;display:grid;gap:7px;max-width:72ch}
+.tl ul.points li{padding-left:18px;position:relative;color:color-mix(in srgb,var(--tx) 88%,var(--tx2))}
+.tl ul.points li::before{content:"—";position:absolute;left:0;color:var(--ac)}
+.tl .chips{margin-top:12px;max-width:72ch}
+
+/* ============ collapsible (work history) ============ */
+.fold{border:1px solid var(--ln);border-radius:var(--r);background:var(--bg2);box-shadow:var(--shadow);margin-top:26px}
+.fold-head{
+  display:flex;justify-content:space-between;align-items:center;gap:12px;
+  width:100%;padding:18px 20px;cursor:pointer;background:none;border:none;color:var(--tx);text-align:left;
+}
+.fold-head h3{font-family:var(--font-head);font-weight:700;font-size:1.05rem}
+.fold-head .chev{color:var(--ac);transition:transform .25s ease;flex:0 0 auto}
+.collapsible-content{max-height:0;overflow:hidden;transition:max-height .3s ease-out}
+.fold-body{padding:0 20px 20px;color:color-mix(in srgb,var(--tx) 88%,var(--tx2))}
+.fold-body p+p{margin-top:12px}
+.fold-body b,.fold-body strong{color:var(--tx);font-weight:600}
+#longHistory{opacity:0;transition:opacity .4s ease;border-left:3px solid var(--ac);padding:4px 0 4px 18px;margin-top:16px;display:grid;gap:12px}
+#longHistory:not(.hidden){opacity:1}
+
+/* ============ tabs (life journey) ============ */
+.tabbar{display:flex;overflow-x:auto;gap:2px;border-bottom:1px solid var(--ln);margin-bottom:0;scrollbar-width:thin}
+.tab-btn{
+  font-family:var(--font-mono);font-size:.74rem;letter-spacing:.06em;white-space:nowrap;
+  background:none;border:none;border-bottom:2px solid transparent;color:var(--tx2);
+  padding:12px 14px;cursor:pointer;transition:color .15s ease,border-color .15s ease;
+}
+.tab-btn:hover{color:var(--ac)}
+.tab-btn.active{color:var(--ac);border-bottom-color:var(--ac)}
+.tabpanes{border:1px solid var(--ln);border-top:none;border-radius:0 0 var(--r) var(--r);background:var(--bg2);box-shadow:var(--shadow)}
+.tab-content{padding:22px;min-height:240px}
+.tab-content.hidden{display:none}
+.jgrid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
+@media(max-width:680px){.jgrid{grid-template-columns:1fr}}
+.jitem{display:flex;gap:14px;align-items:flex-start}
+.jitem .emo{font-size:1.7rem;line-height:1.2;flex:0 0 auto}
+.jitem h3{font-family:var(--font-head);font-weight:700;font-size:.98rem}
+.jitem p{font-size:.88rem;color:var(--tx2)}
+.jitem .jw{font-family:var(--font-mono);font-size:.74rem;color:var(--ac)}
+
+/* ============ CTA banner ============ */
+.cta{
+  display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between;
+  border:1px solid color-mix(in srgb,var(--ac) 40%,var(--ln));border-radius:var(--r);
+  background:linear-gradient(135deg,color-mix(in srgb,var(--ac) 7%,var(--bg2)),var(--bg2) 60%);
+  padding:24px;box-shadow:var(--shadow);margin-top:8px;
+}
+.cta h3{font-family:var(--font-head);font-weight:700;font-size:1.15rem;margin-bottom:4px}
+.cta p{color:var(--tx2);max-width:52ch}
+
+/* ============ chat modal ============ */
+.modal{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:16px;
+  background:color-mix(in srgb,var(--tx) 45%,transparent);backdrop-filter:blur(3px)}
+.modal.hidden{display:none}
+.modal-card{
+  display:flex;flex-direction:column;width:100%;max-width:920px;height:min(82vh,760px);
+  background:var(--bg2);border:1px solid var(--ln);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden;
+}
+.modal-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid var(--ln)}
+.modal-head h3{font-family:var(--font-head);font-weight:700;font-size:1rem}
+.modal-close{background:none;border:1px solid var(--ln);border-radius:8px;color:var(--tx2);width:32px;height:32px;cursor:pointer;font-size:1rem;line-height:1}
+.modal-close:hover{border-color:var(--ac);color:var(--ac)}
+.modal-card iframe{flex:1;width:100%;border:0;background:var(--bg)}
+
+/* ============ quote ============ */
+.quote{margin-top:26px;border-left:3px solid var(--ac);padding:8px 0 8px 26px;max-width:64ch}
+.quote p{font-family:var(--font-head);font-weight:600;font-size:clamp(1.12rem,2.6vw,1.45rem);line-height:1.5;letter-spacing:-.01em}
+.quote .who{font-family:var(--font-mono);font-size:.72rem;font-weight:400;color:var(--tx2);margin-top:16px;letter-spacing:.12em;text-transform:uppercase}
+
+/* ============ section head with side action ============ */
+.sec-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap}
+.sec-head h2{margin-bottom:0}
+.sec-head+*{margin-top:18px}
+
+/* ============ contact / footer ============ */
+.contact{margin-top:72px;border-top:1px solid var(--ln);padding:56px 0 28px;background:var(--bg2)}
+.contact h2{margin-bottom:8px}
+.deline{font-family:var(--font-mono);font-size:.78rem;color:var(--ac);margin-top:12px}
+.refs{font-style:italic;color:var(--tx2);font-size:.9rem;margin-top:22px}
+.sitelinks{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:28px}
+.sitelinks .k{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--tx2);margin-right:6px}
+.foot{
+  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;
+  margin-top:40px;padding-top:18px;border-top:1px solid var(--ln);
+  font-family:var(--font-mono);font-size:.7rem;color:var(--tx2);
+}
+
+/* ============ utility ============ */
+.hidden{display:none}
+
+/* ============ motion & print ============ */
+@media(prefers-reduced-motion:reduce){
+  *,*::before,*::after{animation:none!important;transition:none!important}
+  html{scroll-behavior:auto}
+}
+@media print{
+  .topbar,.actions,.modal,.cta,#themeBtn,#langBtn{display:none!important}
+  body{background:#fff;color:#000}
+  .sec{padding-top:28px}
+  .tl>li,.card{break-inside:avoid}
+  a{color:#000;text-decoration:none}
+  .collapsible-content{max-height:none!important}
+}
