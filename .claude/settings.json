{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/build.py)",
      "Bash(python3 scripts/build.py --check)",
      "Bash(python3 scripts/validate-site.py:*)",
      "Bash(python3 -m unittest discover -s tests/python:*)",
      "Bash(node --test:*)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run validate)",
      "Bash(npm run build)",
      "Bash(python3 scripts/maintenance-scan.py:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-check.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
